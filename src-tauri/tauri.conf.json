{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UURelayBridge",
  "version": "1.18.0",
  "identifier": "com.uurelaybridge.desktop",
  "mainBinaryName": "UURelayBridge",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "UURelayBridge",
        "width": 1080,
        "height": 780,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "visible": true,
        "decorations": true,
        "dragDropEnabled": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "externalBin": ["binaries/uuengine"],
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg"],
    "icon": [
      "../icons/32x32.png",
      "../icons/128x128.png",
      "../icons/128x128@2x.png",
      "../icons/icon.icns",
      "../icons/icon.ico"
    ],
    "publisher": "RelayBridge",
    "copyright": "RelayBridge",
    "category": "Utility",
    "shortDescription": "Clash Verge Rev extension config generator",
    "longDescription": "RelayBridge generates a Clash Verge Rev extension script from your own domain / IP rules. It never modifies your subscriptions, profiles or Clash Verge itself.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
